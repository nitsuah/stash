[
  { "name": "Shopify", "category": "E-commerce", "website": "https://www.shopify.com", "match": { "scripts": ["cdn\.shopify\.com"], "html": ["Shopify\.theme"], "headers": { "x-shopify-stage": "." } }, "example": { "scripts": ["https://cdn.shopify.com/s/files/1/0000/theme.js"] } },
  { "name": "WooCommerce", "category": "E-commerce", "website": "https://woocommerce.com", "match": { "scripts": ["/wp-content/plugins/woocommerce/"], "html": ["class=\"woocommerce"] }, "implies": ["WordPress"], "example": { "scripts": ["/wp-content/plugins/woocommerce/assets/js/frontend/cart.min.js"] } },
  { "name": "Magento", "category": "E-commerce", "website": "https://business.adobe.com/products/magento/magento-commerce.html", "match": { "cookies": ["^mage-"], "scripts": ["/static/version\d+/frontend/"] }, "implies": ["PHP"], "example": { "cookies": ["mage-cache-storage=%7B%7D"] } },
  { "name": "Stripe", "category": "Payment processors", "website": "https://stripe.com", "match": { "scripts": ["js\.stripe\.com"] }, "example": { "scripts": ["https://js.stripe.com/v3/"] } },
  { "name": "PayPal", "category": "Payment processors", "website": "https://www.paypal.com", "match": { "scripts": ["paypal(objects)?\.com/(sdk/js|api/checkout)"] }, "example": { "scripts": ["https://www.paypal.com/sdk/js?client-id=abc"] } },
  { "name": "BigCommerce", "category": "E-commerce", "website": "https://www.bigcommerce.com", "match": { "scripts": ["cdn\.bigcommerce\.com", "bigcommerce\.com.*\.js"], "headers": { "server": "BigCommerce" } }, "example": { "scripts": ["https://cdn.bigcommerce.com/stencil/abc123/theme.js"] } },
  { "name": "PrestaShop", "category": "E-commerce", "website": "https://www.prestashop.com", "match": { "scripts": ["/themes/.*/js/", "prestashop\.com.*\.js"], "cookies": ["^PrestaShop-"] }, "example": { "scripts": ["/themes/classic/js/theme.js"] } },
  { "name": "OpenCart", "category": "E-commerce", "website": "https://www.opencart.com", "match": { "scripts": ["catalog/view/javascript/"], "html": ["opencart"] }, "example": { "scripts": ["catalog/view/javascript/common.js"] } },
  { "name": "Ecwid", "category": "E-commerce", "website": "https://www.ecwid.com", "match": { "scripts": ["app\.ecwid\.com", "static\.ecwid\.com"] }, "example": { "scripts": ["https://app.ecwid.com/script.js?12345"] } },
  { "name": "Snipcart", "category": "E-commerce", "website": "https://snipcart.com", "match": { "scripts": ["cdn\.snipcart\.com", "snipcart\.com.*\.js"] }, "example": { "scripts": ["https://cdn.snipcart.com/scripts/3.0/snipcart.js"] } },
  { "name": "Lemon Squeezy", "category": "E-commerce", "website": "https://www.lemonsqueezy.com", "match": { "scripts": ["cdn\.lemonsqueezy\.com", "lemonsqueezy\.com.*\.js"] }, "example": { "scripts": ["https://cdn.lemonsqueezy.com/lemonsqueezy.js"] } },
  { "name": "Paddle", "category": "Payment processors", "website": "https://paddle.com", "match": { "scripts": ["cdn\.paddle\.com", "paddle\.com.*\.js"], "html": ["data-paddle-button"] }, "example": { "scripts": ["https://cdn.paddle.com/paddle/paddle.js"] } },
  { "name": "Square", "category": "Payment processors", "website": "https://squareup.com", "match": { "scripts": ["js\.squareupsandbox\.com", "js\.squareup\.com", "squareupsandbox\.com.*\.js", "squareup\.com.*\.js"] }, "example": { "scripts": ["https://js.squareup.com/v2/paymentform"] } },
  { "name": "Braintree", "category": "Payment processors", "website": "https://www.braintreepayments.com", "match": { "scripts": ["js\.braintreegateway\.com", "braintreegateway\.com.*\.js"] }, "example": { "scripts": ["https://js.braintreegateway.com/web/3.80.0/js/client.min.js"] } },
  { "name": "Adyen", "category": "Payment processors", "website": "https://www.adyen.com", "match": { "scripts": ["checkoutshopper-test\.adyen\.com", "checkoutshopper-live\.adyen\.com"], "html": ["data-adyen-client-key"] }, "example": { "scripts": ["https://checkoutshopper-test.adyen.com/checkoutshopper/sdk/5.0.0/adyen.js"] } },
  { "name": "Razorpay", "category": "Payment processors", "website": "https://razorpay.com", "match": { "scripts": ["checkout\.razorpay\.com"], "html": ["data-razorpay-key"] }, "example": { "scripts": ["https://checkout.razorpay.com/v1/checkout.js"] } },
  { "name": "Mollie", "category": "Payment processors", "website": "https://www.mollie.com", "match": { "scripts": ["js\.mollie\.com", "mollie\.com.*\.js"] }, "example": { "scripts": ["https://js.mollie.com/v1/mollie.js"] } },
  { "name": "Klarna", "category": "Payment processors", "website": "https://www.klarna.com", "match": { "scripts": ["cdn\.klarna\.com", "klarna\.com.*\.js"], "html": ["data-klarna-button"] }, "example": { "scripts": ["https://cdn.klarna.com/kp/kp.js"] } },
  { "name": "Afterpay", "category": "Payment processors", "website": "https://www.afterpay.com", "match": { "scripts": ["portal\.afterpay\.com", "afterpay\.com.*\.js"] }, "example": { "scripts": ["https://portal.afterpay.com/afterpay.js"] } },
  { "name": "Squarespace Commerce", "category": "E-commerce", "website": "https://www.squarespace.com/commerce", "match": { "scripts": ["assets\.squarespace\.com", "squarespace\.com.*\.js"], "html": ["id=\"squarespace-"] }, "example": { "scripts": ["https://assets.squarespace.com/universal/scripts-compressed/abc123.js"] } },
  { "name": "Wix Stores", "category": "E-commerce", "website": "https://www.wix.com/stores", "match": { "scripts": ["static\.wixstatic\.com", "wix\.com.*\.js"], "headers": { "x-wix-request-id": "." } }, "example": { "scripts": ["https://static.wixstatic.com/services/abc123.js"] } }
]
