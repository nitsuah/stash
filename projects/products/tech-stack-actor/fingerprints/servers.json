  { "name": "ASP.NET", "category": "Web frameworks", "website": "https://dotnet.microsoft.com/apps/aspnet", "match": { "headers": { "x-powered-by": "ASP\\.NET", "x-aspnet-version": "." }, "cookies": ["^ASP\\.NET_SessionId="] }, "example": { "headers": { "x-powered-by": "ASP.NET" } } }
