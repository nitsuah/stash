[
  { "name": "Cloudflare", "category": "CDN", "website": "https://www.cloudflare.com", "match": { "headers": { "server": "^cloudflare$", "cf-ray": "." } }, "example": { "headers": { "server": "cloudflare", "cf-ray": "8abc123-IAD" } } },
  { "name": "Netlify", "category": "Hosting", "website": "https://www.netlify.com", "match": { "headers": { "server": "^Netlify$", "x-nf-request-id": "." } }, "example": { "headers": { "server": "Netlify", "x-nf-request-id": "01HABC" } } },
  { "name": "Vercel", "category": "Hosting", "website": "https://vercel.com", "match": { "headers": { "server": "^Vercel$", "x-vercel-id": "." } }, "example": { "headers": { "server": "Vercel", "x-vercel-id": "iad1::abc" } } },
  { "name": "Amazon CloudFront", "category": "CDN", "website": "https://aws.amazon.com/cloudfront/", "match": { "headers": { "via": "CloudFront", "x-amz-cf-id": "." } }, "example": { "headers": { "via": "1.1 abc.cloudfront.net (CloudFront)", "x-amz-cf-id": "abc" } } },
  { "name": "Fastly", "category": "CDN", "website": "https://www.fastly.com", "match": { "headers": { "x-served-by": "^cache-", "x-fastly-request-id": "." } }, "example": { "headers": { "x-served-by": "cache-iad-kiad7000012-IAD" } } },
  { "name": "Akamai", "category": "CDN", "website": "https://www.akamai.com", "match": { "headers": { "server": "AkamaiGHost|Akamai", "via": "akamai", "x-akamai-transformed": "." } }, "example": { "headers": { "server": "AkamaiGHost", "via": "1.1 akamai.net (AkamaiGHost)" } } },
  { "name": "Azure Front Door", "category": "CDN", "website": "https://azure.microsoft.com/services/frontdoor/", "match": { "headers": { "server": "AzureFrontDoor", "x-azure-ref": ".", "x-azure-fdid": "." } }, "example": { "headers": { "server": "AzureFrontDoor", "x-azure-ref": "0ABC123+XYZ" } } },
  { "name": "GitHub Pages", "category": "Hosting", "website": "https://pages.github.com", "match": { "headers": { "server": "GitHub\\.com", "x-github-request-id": ".", "x-served-by": "github-pages" } }, "example": { "headers": { "server": "GitHub.com", "x-github-request-id": "ABC123" } } },
  { "name": "GitLab Pages", "category": "Hosting", "website": "https://docs.gitlab.com/ee/user/project/pages/", "match": { "headers": { "server": "GitLab", "x-gitlab-pages": "." } }, "example": { "headers": { "server": "GitLab", "x-gitlab-pages": "true" } } },
  { "name": "Render", "category": "Hosting", "website": "https://render.com", "match": { "headers": { "server": "Render", "x-render-request-id": ".", "x-render-origin-server": "." } }, "example": { "headers": { "server": "Render", "x-render-request-id": "abc123" } } },
  { "name": "Heroku", "category": "Hosting", "website": "https://www.heroku.com", "match": { "headers": { "server": "Heroku", "via": "heroku", "x-heroku-dyno-request-id": "." } }, "example": { "headers": { "server": "Heroku", "via": "1.1 heroku.com" } } },
  { "name": "Fly.io", "category": "Hosting", "website": "https://fly.io", "match": { "headers": { "server": "fly", "fly-region": ".", "fly-request-id": "." } }, "example": { "headers": { "server": "fly", "fly-region": "iad" } } },
  { "name": "DigitalOcean App Platform", "category": "Hosting", "website": "https://www.digitalocean.com/products/app-platform", "match": { "headers": { "server": "DigitalOcean", "x-digitalocean-app-platform": "." } }, "example": { "headers": { "server": "DigitalOcean", "x-digitalocean-app-platform": "true" } } },
  { "name": "Varnish", "category": "CDN", "website": "https://varnish-cache.org", "match": { "headers": { "x-varnish": ".", "via": "varnish", "server": "Varnish" } }, "example": { "headers": { "x-varnish": "123456789", "via": "1.1 varnish (Varnish/7.2)" } } },
  { "name": "HAProxy", "category": "CDN", "website": "https://www.haproxy.org", "match": { "headers": { "server": "haproxy", "x-haproxy": ".", "via": "haproxy" } }, "example": { "headers": { "server": "haproxy", "x-haproxy": "1.2.3" } } },
  { "name": "Sucuri", "category": "CDN", "website": "https://sucuri.net", "match": { "headers": { "server": "Sucuri|Cloudproxy", "x-sucuri-id": ".", "x-sucuri-cache": "." } }, "example": { "headers": { "server": "Sucuri/Cloudproxy", "x-sucuri-id": "abc123" } } },
  { "name": "Imperva", "category": "CDN", "website": "https://www.imperva.com", "match": { "headers": { "server": "Incapsula", "x-iinfo": ".", "x-cdn": "Imperva" } }, "example": { "headers": { "server": "Incapsula", "x-iinfo": "abc123" } } },
  { "name": "BunnyCDN", "category": "CDN", "website": "https://bunny.net", "match": { "headers": { "server": "BunnyCDN", "cdn-pullzone": ".", "x-bunnycdn-cache": "." } }, "example": { "headers": { "server": "BunnyCDN", "cdn-pullzone": "myzone" } } },
  { "name": "KeyCDN", "category": "CDN", "website": "https://www.keycdn.com", "match": { "headers": { "server": "KeyCDN", "x-edge-location": ".", "x-cache": "HIT|MISS" } }, "example": { "headers": { "server": "KeyCDN", "x-edge-location": "iad" } } },
  { "name": "Google Cloud Storage", "category": "CDN", "website": "https://cloud.google.com/storage", "match": { "headers": { "server": "UploadServer", "x-goog-generation": ".", "x-goog-storage-class": "." } }, "example": { "headers": { "server": "UploadServer", "x-goog-generation": "123456789" } } },
  { "name": "Amazon S3", "category": "Hosting", "website": "https://aws.amazon.com/s3/", "match": { "headers": { "server": "AmazonS3", "x-amz-request-id": ".", "x-amz-id-2": "." } }, "example": { "headers": { "server": "AmazonS3", "x-amz-request-id": "ABC123" } } },
  { "name": "Firebase Hosting", "category": "Hosting", "website": "https://firebase.google.com/docs/hosting", "match": { "headers": { "server": "Firebase", "x-firebase-hosting": ".", "x-firebase-request-id": "." } }, "example": { "headers": { "server": "Firebase", "x-firebase-hosting": "true" } } },
  { "name": "Cloudflare Pages", "category": "Hosting", "website": "https://pages.cloudflare.com", "match": { "headers": { "server": "cloudflare", "cf-ray": ".", "x-cloudflare-pages": "." } }, "example": { "headers": { "server": "cloudflare", "cf-ray": "8abc123-IAD", "x-cloudflare-pages": "true" } } }
