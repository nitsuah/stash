#!/usr/bin/env bash
# stash pre-commit: stop secrets and PII before they reach a PUBLIC repo.
# Enable once per clone:  git config core.hooksPath .githooks
#
# 1. gitleaks on the STAGED changes (.gitleaks.toml): a local gitleaks binary if
#    installed, else Docker; if neither is available, warn and rely on CI.
# 2. agent/scripts/pii-scan.sh on staged files under the auto-published folders
#    (agent/reports/, agent/notes/), the same scope CI enforces.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

# --- 1. secrets -------------------------------------------------------------
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --config .gitleaks.toml --redact --no-banner -v
elif docker info >/dev/null 2>&1; then
  MSYS_NO_PATHCONV=1 docker run --rm -v "$root:/repo" --entrypoint sh ghcr.io/gitleaks/gitleaks:latest -c \
    'git config --global --add safe.directory /repo && cd /repo && gitleaks git --pre-commit --staged --config .gitleaks.toml --redact --no-banner -v'
else
  echo "pre-commit: gitleaks and Docker are both unavailable; skipping the local secret scan (CI still runs it)." >&2
fi

# --- 2. PII in auto-published folders -----------------------------------------
staged=()
while IFS= read -r -d '' f; do
  case "$f" in
    agent/reports/*|agent/notes/*) staged+=("$f") ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if [ "${#staged[@]}" -gt 0 ]; then
  bash agent/scripts/pii-scan.sh "${staged[@]}"
fi
