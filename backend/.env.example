# Local development values only. Do not reuse in any shared or deployed environment.
# Flask reads this as a relative SQLite file. Express (Sequelize) would treat the
# same URL as the absolute path /dev.db, so run Express with DATABASE_URL=sqlite::memory:
# (see backend/README.md) or point both at Postgres.
DATABASE_URL=sqlite:///dev.db
JWT_SECRET=dev-only-secret-change-me-0123456789
DEMO_LOGIN_ENABLED=true
# DEMO_EMAIL=user@example.com
# DEMO_PASSWORD=password
